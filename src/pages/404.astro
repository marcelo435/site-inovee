---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import logo from '../assets/logo-inovee.png';
---

<Base
  title="Página não encontrada | Inovee Contabilidade"
  description="Não encontramos esta página. Volte ao início ou fale com a equipe da Inovee."
  noindex
>
  <section class="pagina-404">
    <div class="wrap">
      <a href="/" class="logo-404" aria-label="Inovee Consultoria e Contabilidade — início">
        <Image src={logo} alt="" width={240} height={84} densities={[1, 2]} loading="eager" />
      </a>
      <p class="codigo" aria-hidden="true">404</p>
      <h1 class="t-xl">Não encontramos esta página</h1>
      <p class="lead">O endereço pode ter mudado ou não existe mais. Use os botões abaixo para continuar.</p>
      <div class="hero-acoes">
        <a href="/" class="btn btn-solid">Voltar ao início</a>
        <a href="/contato/" class="btn btn-ghost">Falar com a Inovee</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .pagina-404 { padding: clamp(140px, 18vh, 200px) 0 clamp(80px, 12vh, 140px); text-align: center; }
  .pagina-404 .wrap { display: flex; flex-direction: column; align-items: center; gap: 18px; }
  .pagina-404 img { width: 240px; height: auto; }
  .pagina-404 .codigo { font-family: var(--f-display); font-size: clamp(4rem, 12vw, 7rem); font-weight: 300; line-height: 1; color: var(--volt); }
  .pagina-404 .lead { max-width: 520px; }
  .pagina-404 .hero-acoes { justify-content: center; }
  :global([data-theme='dark']) .pagina-404 img { background: #fff; padding: 10px 16px; border-radius: 12px; }
</style>
