---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Destaques from '../components/Destaques.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Steps from '../components/Steps.astro';
import Units from '../components/Units.astro';
import News from '../components/News.astro';
import Faq from '../components/Faq.astro';
import Contact from '../components/Contact.astro';
import { perguntas } from '../data/faq';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: perguntas.map((q) => ({
    '@type': 'Question',
    name: q.p,
    acceptedAnswer: { '@type': 'Answer', text: q.r },
  })),
};
---

<Base
  title="Inovee Consultoria e Contabilidade"
  description="A Inovee oferece serviços de contabilidade, assessoria fiscal e departamento pessoal para empresas. Conheça nossos serviços e fale com a equipe."
  schema={faqSchema}
>
  <Hero />
  <Destaques />
  <Services />
  <About />
  <Steps />
  <Units />
  <News />
  <Faq />
  <Contact />
</Base>
