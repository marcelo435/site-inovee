---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Contact from '../components/Contact.astro';
---

<Base
  title="Contato | Inovee Contabilidade"
  description="Fale com a Inovee pelo WhatsApp, telefone ou e-mail. Primeira consulta gratuita, com atendimento presencial em Pernambuco e online em todo o Brasil."
>
  <PageHero
    titulo="Contato"
    subtitulo="Fale com a nossa equipe pelo canal que preferir. A primeira consulta é gratuita."
    migalhas={[{ href: '/contato/', label: 'Contato' }]}
  />
  <Contact />
</Base>
