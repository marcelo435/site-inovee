---
import { Image } from 'astro:assets';
import simbolo from '../assets/inovee-simbolo.png';

---

<section class="hero" id="home">
  <div class="hero-3d" id="simbolo3d" aria-hidden="true">
    <!-- Logo parado: só aparece se o 3D não funcionar no aparelho (escondido, não é baixado antes disso) -->
    <Image class="poster" src={simbolo} alt="" width={300} height={300} loading="lazy" />
  </div>

  <div class="hero-inner">
    <div>
      <h1 class="t-hero">Sua contabilidade inteligente, presencial e digital, sempre perto de você.</h1>
      <p class="lead">
        Há mais de 10 anos cuidamos de empresas de todos os portes, do MEI à grande empresa, no Simples Nacional, no
        Lucro Presumido e no Lucro Real. Quatro unidades em Pernambuco e atendimento online em todo o Brasil.
      </p>
      <div class="hero-acoes">
        <a href="#contato" class="btn btn-solid">Agendar consulta gratuita <span class="seta">→</span></a>
        <a href="#servicos" class="btn btn-ghost">Ver serviços</a>
      </div>
    </div>
  </div>

</section>

<script>
  // O arquivo do 3D começa a baixar já (este script só roda depois que o HTML abriu,
  // então não atrasa o texto). A montagem da cena espera um respiro curto do navegador.
  const alvo = document.getElementById('simbolo3d');
  if (alvo) {
    const quandoLivre = (fn: () => void) =>
      'requestIdleCallback' in window ? requestIdleCallback(fn, { timeout: 300 }) : setTimeout(fn, 50);
    const semTresD = () => alvo.classList.add('sem-3d');
    import('../scripts/simbolo3d')
      .then((m) =>
        quandoLivre(() => {
          // erro na montagem (ex.: placa de vídeo do celular) → mantém o logo parado
          try {
            m.iniciarSimbolo(alvo);
          } catch {
            alvo.querySelector('canvas')?.remove();
            semTresD();
          }
        }),
      )
      .catch(semTresD);
  }
</script>
